# Production Environment Guardrails
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.notesprintai.vercel.app
CLIENT_URL=https://www.notesprintai.vercel.app
JWT_SECRET=your_secure_random_jwt_secret

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/notesprint?retryWrites=true&w=majority

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP Mail Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=support@notesprintai.vercel.app

# Redis Queue
REDIS_URL=redis://default:password@redis-host:6379
